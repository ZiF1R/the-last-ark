    forbiddenFlags: []
    requiredTags: 
    forbiddenTags: 
  - id: end_no_signal
    title: NO SIGNAL
    body: The science station goes dark. The samples are still in the fridge. The
      fridge is still cold. Nobody knows how to run the fridge. The log has a line
      for this. The line is blank.
    priority: 100
    minSurvival: 0
    minScience: 0
    minMorale: 0
    maxSurvival: 10
    maxScience: 0
    maxMorale: 10
