  endings:
  - id: end_no_air
    title: NO AIR
    body: The gauge hits zero. The recycler stops. The crew has been holding its
      breath for two days. The log records the last reading. The pen is still in
      the holder.
    priority: 100
    minSurvival: 0
    minScience: 0
    minMorale: 0
    maxSurvival: 0
    maxScience: 10
    maxMorale: 10
